# Copy to `eval-memory/.env` and fill in values. The real .env is
# gitignored. Loaded via `process.loadEnvFile` at the top of every
# `npm run eval:memory*` invocation.

# --- llama-server (under test) ---------------------------------------------
# URL the agent / runners talk to. When set, the scripts skip managed-daemon
# control and assume llama-server is already up at this URL. When unset,
# `eval-memory/scripts/run-*.mjs` call `atomic-agent models status|start`
# to bring the daemon up themselves (same pattern as eval/scripts/run-full-eval.mjs).
ATOMIC_AGENT_EVAL_LLAMA_URL=

# Keep the managed daemon running after the experiment exits. Useful when
# chaining multiple experiments back-to-back.
# ATOMIC_AGENT_EVAL_KEEP_DAEMON=1

# --- LLM-as-judge (E2 / E3 / E4) -------------------------------------------
# Required when the judge base URL is remote (default: OpenRouter).
# Get a key at https://openrouter.ai/keys. Prefix: sk-or-v1-...
OPENROUTER_API_KEY=

# Optional overrides — same shape as eval/.env.example.
# ATOMIC_AGENT_JUDGE_MODEL=openai/gpt-4o-mini
# ATOMIC_AGENT_JUDGE_URL=https://openrouter.ai/api/v1
# ATOMIC_AGENT_JUDGE_TIMEOUT_MS=30000
# ATOMIC_AGENT_JUDGE_DISABLED=1     # set to 1 to skip every judge expectation

# --- E1 knobs ---------------------------------------------------------------
# Minimum P@5 the runner asserts for the `hybrid` mode (decision boundary
# from PLAN.md). Below this the experiment exits non-zero.
# ATOMIC_AGENT_E1_MIN_PRECISION_AT_5=0.6

# Minimum delta in P@5 vs BM25-only that the runner requires for `hybrid`
# to be considered "actually better than baseline". Default 0.05 (5 pp).
# ATOMIC_AGENT_E1_MIN_HYBRID_DELTA=0.05
