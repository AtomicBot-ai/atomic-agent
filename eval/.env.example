# Copy to `eval/.env` and fill in values. The real .env is gitignored.
# Loaded via `process.loadEnvFile` at the start of every `npm run eval` and
# `npm run eval:judge` invocation.

# --- llama-server (agent under test) ---------------------------------------
# URL the spawned agent subprocess talks to. Overrides the default 127.0.0.1:8080
# that ships in the user config file created in each per-case temp stateDir.
# When unset, every case times out after ~16s waiting on health-check.
ATOMIC_AGENT_EVAL_LLAMA_URL=http://127.0.0.1:18991

# --- LLM-as-judge ----------------------------------------------------------
# Required when the judge base URL is remote (default: OpenRouter).
# Get a key at https://openrouter.ai/keys. Prefix: sk-or-v1-...
OPENROUTER_API_KEY=

# Optional: override the default judge model (openai/gpt-4o-mini).
# Alternatives to try:
#   anthropic/claude-3.5-haiku   — stricter rubric adherence, pricier
#   google/gemini-2.0-flash-001  — cheap, fast
# ATOMIC_AGENT_JUDGE_MODEL=

# Optional: override judge base URL (e.g. point at a local llama-server).
# ATOMIC_AGENT_JUDGE_URL=http://127.0.0.1:18991

# Optional: per-call judge timeout (default 30_000).
# ATOMIC_AGENT_JUDGE_TIMEOUT_MS=
