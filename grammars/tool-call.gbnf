# Array-only root. Every completion starts with `[` so the model cannot
# fall into the single-object form via first-token bias even when it
# only needs one call. A solo step is the model emitting [{...}].
# Up to 16 calls per completion (runtime also clamps via config).
root ::= tool-call-array
# `reply` has its own branch (#681). Its `text` is prose, and prose
# quotes things: `stored in memory: "foo"`. Tokenizers merge ` "` and
# `:"` into one token, and under the generic string rule that token is a
# legal string close, so the reply ended at `memory:`, `}}]` followed,
# the stop came with stop:true and the truncated reply parsed as valid.
# `reply-text` refuses to close right after a "soft" character (space,
# `:`, `(`, `[`, `{`, `=`, `,`): the merged token is no longer a way out
# and the sampler has to escape the quote instead. The args are strict
# (`text`, then optional `attachments`) so the generic object cannot
# carry a reply around the rule; `tool-name` does not list "reply".
tool-call ::= reply-call | shell-call | fs-read-call | fs-write-call | fs-edit-call | fs-move-call | fs-list-call | fs-grep-call | fs-glob-call | web-search-call | web-fetch-call | http-request-call | skill-view-call | tool-view-call | tool-search-call | notes-store-call | notes-recall-call | other-call
reply-call ::= "{" ws "\"tool\"" ws ":" ws "\"reply\"" ws "," ws "\"args\"" ws ":" ws reply-args ws "}"
other-call ::= "{" ws "\"tool\"" ws ":" ws tool-name ws "," ws "\"args\"" ws ":" ws object ws "}"
# `os.shell.run` has its own branch too: under the generic `object` rule its
# args could be `{}`, and small local models took that way out, emitting
# `{"tool":"os.shell.run","args":{}}` instead of the command they had just
# planned (Nemotron 3.5 Bolt E4B, 23.10.2026). Here `cmd` comes first and is
# a `required-string` (below: non-empty, may open on an escape such as the
# alias-skipping `\\ls`, marker guard intact); the other keys stay
# free-form. `tool-name` does not list "os.shell.run".
shell-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.shell.run\"" ws "," ws "\"args\"" ws ":" ws shell-args ws "}"
shell-args ::= "{" ws "\"cmd\"" ws ":" ws required-string ( ws "," ws pair )* ws "}"
# The same hole, and the same fix, for `os.fs.read` and `os.fs.write`
# (ATO-909): `{"tool":"os.fs.read","args":{}}` was legal and fails in the
# tool. Each tool's own check is the bar: read needs a non-empty `path`;
# write needs a non-empty `path` and a `content` string, which may be
# empty (an empty file is a real write). The required keys come first,
# in the order the descriptors teach; every other key stays free-form,
# as the tool decides what it accepts. `required-string` is a non-empty
# string (`chars-nonempty`: `chars` with at least one character), so a
# reasoning profile's marker guard, which rewrites both rules, sees every
# character, the first included; it may open on an escape (a JSON-escaped
# UNC path does) or on `<` (an `oldString` of `<div>`). `tool-name` lists
# none of the names with a branch. Known limit, here and in `shell-args`:
# the free keys may repeat a required one
# (`{"path":"a","content":"x","path":""}`), and JSON.parse keeps the
# last, so the tool still sees an empty value and refuses it; ruling that
# out would mean a key rule that excludes each required name.
fs-read-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.fs.read\"" ws "," ws "\"args\"" ws ":" ws path-args ws "}"
fs-write-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.fs.write\"" ws "," ws "\"args\"" ws ":" ws fs-write-args ws "}"
fs-write-args ::= "{" ws "\"path\"" ws ":" ws required-string ws "," ws "\"content\"" ws ":" ws string ( ws "," ws pair )* ws "}"
# ATO-1114: the rest of the tools a small model uses in an ordinary
# coding or file session, each held to its own check the same way.
# `os.fs.edit` (`parseEditArgs`): non-empty `path` and `oldString`, a
# `newString` string that may be empty (a deletion). `os.fs.list`
# (`parseListArgs`): non-empty `path`. `os.fs.grep`: non-empty `pattern`.
# `os.fs.glob`: `pattern` as a non-empty string or a non-empty list of
# them. `os.web.search`: non-empty `query`. `os.web.fetch` and
# `os.http.request`: non-empty `url`. `skill.view` and `tool.view`:
# non-empty `name`. `memory.notes.store`: non-empty `content`.
# `memory.notes.recall`: `query` (any string, the tool takes it as is)
# or `id`.
fs-edit-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.fs.edit\"" ws "," ws "\"args\"" ws ":" ws fs-edit-args ws "}"
fs-edit-args ::= "{" ws "\"path\"" ws ":" ws required-string ws "," ws "\"oldString\"" ws ":" ws required-string ws "," ws "\"newString\"" ws ":" ws string ( ws "," ws pair )* ws "}"
# `os.fs.move` (`parseMoveArgs`) takes `{from, to}` or `{moves: [{from,
# to}, ...]}`, every path non-empty. The source-side aliases small models
# send instead (`paths`, `sources`, `src`, `source`, read by
# `fs-move-aliases.ts`, ATO-899) still open the args, with any value: the
# alias reader decides, as before. What is gone is `{}`.
fs-move-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.fs.move\"" ws "," ws "\"args\"" ws ":" ws fs-move-args ws "}"
fs-move-args ::= "{" ws ( fs-move-pair | "\"moves\"" ws ":" ws fs-move-list | fs-move-alias ws ":" ws value ) ( ws "," ws pair )* ws "}"
fs-move-pair ::= "\"from\"" ws ":" ws required-string ws "," ws "\"to\"" ws ":" ws required-string
fs-move-list ::= "[" ws fs-move-item ( ws "," ws fs-move-item )* ws "]"
fs-move-item ::= "{" ws fs-move-pair ( ws "," ws pair )* ws "}"
fs-move-alias ::= "\"" ( "paths" | "sources" | "src" | "source" ) "\""
fs-list-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.fs.list\"" ws "," ws "\"args\"" ws ":" ws path-args ws "}"
fs-grep-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.fs.grep\"" ws "," ws "\"args\"" ws ":" ws "{" ws "\"pattern\"" ws ":" ws required-string ( ws "," ws pair )* ws "}" ws "}"
fs-glob-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.fs.glob\"" ws "," ws "\"args\"" ws ":" ws "{" ws "\"pattern\"" ws ":" ws ( required-string | "[" ws required-string ( ws "," ws required-string )* ws "]" ) ( ws "," ws pair )* ws "}" ws "}"
web-search-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.web.search\"" ws "," ws "\"args\"" ws ":" ws "{" ws "\"query\"" ws ":" ws required-string ( ws "," ws pair )* ws "}" ws "}"
web-fetch-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.web.fetch\"" ws "," ws "\"args\"" ws ":" ws url-args ws "}"
http-request-call ::= "{" ws "\"tool\"" ws ":" ws "\"os.http.request\"" ws "," ws "\"args\"" ws ":" ws url-args ws "}"
skill-view-call ::= "{" ws "\"tool\"" ws ":" ws "\"skill.view\"" ws "," ws "\"args\"" ws ":" ws name-args ws "}"
tool-view-call ::= "{" ws "\"tool\"" ws ":" ws "\"tool.view\"" ws "," ws "\"args\"" ws ":" ws name-args ws "}"
# `tool.search` (ATO-558) needs words to search for: a non-empty `query`
# first, `limit` and any other key free. `tool-name` does not list it.
tool-search-call ::= "{" ws "\"tool\"" ws ":" ws "\"tool.search\"" ws "," ws "\"args\"" ws ":" ws "{" ws "\"query\"" ws ":" ws required-string ( ws "," ws pair )* ws "}" ws "}"
notes-store-call ::= "{" ws "\"tool\"" ws ":" ws "\"memory.notes.store\"" ws "," ws "\"args\"" ws ":" ws "{" ws "\"content\"" ws ":" ws required-string ( ws "," ws pair )* ws "}" ws "}"
notes-recall-call ::= "{" ws "\"tool\"" ws ":" ws "\"memory.notes.recall\"" ws "," ws "\"args\"" ws ":" ws "{" ws ( "\"query\"" ws ":" ws string | "\"id\"" ws ":" ws value ) ( ws "," ws pair )* ws "}" ws "}"
path-args ::= "{" ws "\"path\"" ws ":" ws required-string ( ws "," ws pair )* ws "}"
url-args ::= "{" ws "\"url\"" ws ":" ws required-string ( ws "," ws pair )* ws "}"
name-args ::= "{" ws "\"name\"" ws ":" ws required-string ( ws "," ws pair )* ws "}"
required-string ::= "\"" chars-nonempty "\""
reply-args ::= "{" ws "\"text\"" ws ":" ws reply-text ( ws "," ws "\"attachments\"" ws ":" ws value )? ws "}"
reply-text ::= "\"" reply-pending "\""
# Right recursion over the last character: `reply-chars` may end (the
# string may close) only after a hard character; `reply-pending` must
# continue. The text starts in `reply-pending`, so it cannot be empty
# either: a reply that opens on a quote cannot close on it.
reply-chars ::= ( reply-hard reply-chars | reply-soft reply-pending )?
reply-pending ::= reply-hard reply-chars | reply-soft reply-pending
reply-hard ::= [^"\\\x00-\x1f :(\[{=,] | "\\" escape
reply-soft ::= [ :(\[{=,]
tool-call-array ::= "[" ws tool-call ( ws "," ws tool-call ){0,15} ws "]"
tool-name ::= browser-tool | os-tool | discovery-tool | memory-tool | tasks-tool | vision-tool | image-tool | fusion-tool | verify-tool | plan-tool | mcp-native-tool | "\"finish\""
browser-tool ::= "\"browser." ( "navigate" | "click" | "type" | "read_aria" | "search" | "tabs" | "scroll" | "extract" ) "\""
os-tool ::= "\"os." ( "fs.read_document" | "fs.trash" | "fs.locate_project" | "fs.code_map" | "fs.hash" | "fs.diff" | "fs.patch" | "fs.restore" | "fs.watch" | "fs.archive.list" | "fs.archive.read_entry" | "fs.archive.extract" | "git.status" | "git.log" | "git.diff" | "git.show" | "git.blame" | "git.branch" | "git.init" | "git.add" | "git.commit" | "git.checkout" | "git.clone" | "git.remote" | "git.fetch" | "git.pull" | "git.push" | "proc.list" | "proc.kill" | "clipboard.read" | "clipboard.write" | "window.list" | "window.focus" | "notify" | "email.inbox" | "email.send" | "screen.point" | "screen.capture" | "screen.click" | "screen.type" | "screen.key" ) "\""
discovery-tool ::= "\"skill.run_script\""
memory-tool ::= "\"memory." ( "profile.set" | "profile.remove" | "profile.list" | "profile.history" | "notes.forget" | "lessons.recall" | "procedures.recall" ) "\""
tasks-tool ::= "\"tasks." ( "schedule" | "cron" | "list" | "cancel" | "show" ) "\""
vision-tool ::= "\"vision.describe\""
image-tool ::= "\"image.generate\""
# Fusion's fan-out. Listed here for the same reason `tasks.*` is: the
# grammar is the local model's whole vocabulary of tool names, and a
# name missing from it cannot be emitted at all. A LOCAL orchestrator
# is the case that needs it — it reasoned "I need to call
# fusion.delegate", the constrained sampler had no such name, and it
# was pushed into `finish` instead, reporting a fan-out that never
# happened. Unconditional, like `tasks.*`: availability is the
# registry's business, not the sampler's, and a fusion worker (which is
# also grammar-constrained) is refused by `fusion.delegate` itself when
# it tries to fan out again.
fusion-tool ::= "\"fusion.delegate\""
# Read-only verification (syntax per file; a command, service or page
# run against a throwaway copy). A local orchestrator reviewing a fan-out
# needs these in its vocabulary for the same reason it needs the fan-out.
verify-tool ::= "\"verify." ( "syntax" | "run" ) "\""
# The live task plan. The prompt tells the model to keep it for any work of
# three steps or more, so a local model has to be able to spell the name.
plan-tool ::= "\"plan.update\""
# Native MCP discovery / resource / prompt tools. Registered once MCP is on
# (a server configured, or added live) and never unregistered, so they stay
# after the last server is removed live; with MCP off from the start
# `applyMcpToolNameRule` drops this from `tool-name`.
mcp-native-tool ::= "\"mcp." ( "resource.list" | "resource.read" | "prompt.list" | "prompt.get" ) "\""
# Per-server MCP tool names. Deliberately NOT referenced from `tool-name`
# here: with no MCP tools the sampler can emit no `mcp.<server>.<tool>`
# name, because a permissive shape let a local model invent one
# (`mcp.example.toolkit`) and the turn died on "tool not registered"
# (ATO-1029). When MCP tools exist, `applyMcpToolNameRule`
# (`src/mcp/mcp-grammar-builder.ts`) replaces this placeholder with the
# real list of qualified names and adds `mcp-server-tool` back to
# `tool-name`, right after `mcp-native-tool`.
mcp-server-tool ::= "\"mcp." [a-z0-9-]+ "." [a-zA-Z0-9._-]+ "\""

value ::= object | array | string | number | boolean | null-lit

object ::= "{" ws ( pair ( ws "," ws pair )* )? ws "}"
pair ::= string ws ":" ws value

array ::= "[" ws ( value ( ws "," ws value )* )? ws "]"

string ::= "\"" chars "\""
chars ::= char*
chars-nonempty ::= char chars
char ::= [^"\\\x00-\x1f] | "\\" escape
escape ::= "\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" | "u" hex hex hex hex
hex ::= [0-9a-fA-F]

number ::= integer fraction? exponent?
integer ::= "-"? ( "0" | [1-9] [0-9]* )
fraction ::= "." [0-9]+
exponent ::= ("e" | "E") ("+" | "-")? [0-9]+

boolean ::= "true" | "false"
null-lit ::= "null"

# Bounded, deliberately. Whitespace is legal at ~10 seams inside the JSON
# body and GBNF masks EOG until the whole root is satisfied, so an
# unbounded `[ \t\n\r]*` gives a stuck sampler an infinite legal move: it
# emits newlines until `n_predict` while the stream parser (still waiting
# on `"tool":`) surfaces nothing to the UI — a silent multi-minute hang.
# 64 is far past any realistic newline+indent run (deep pretty-printed
# JSON tops out well under it); past that the mask simply forces the next
# real token, which is the desired recovery. Same grouped `{0,n}` shape
# already used for the reasoning-seam whitespace rule in build-grammar.ts.
ws ::= ( [ \t\n\r] ){0,64}
