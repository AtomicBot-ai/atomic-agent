<component type="desktop-application">
  <id>io.atomicagent.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Atomic Agent</name>
  <summary>Local AI agent with a chat window</summary>
  <developer id="io.atomicagent">
    <name>Atomic Bot</name>
  </developer>
  <description>
    <p>
      Atomic Agent is an AI agent that runs on your computer. The desktop app
      starts the bundled agent locally and gives it a chat window. It can run
      local models through the bundled Atomic Chat Core or use a cloud model
      with your own key.
    </p>
  </description>
  <launchable type="desktop-id">io.atomicagent.desktop.desktop</launchable>
  <url type="homepage">https://atomicagent.io</url>
  <url type="bugtracker">https://github.com/AtomicBot-ai/atomic-agent/issues</url>
  <url type="vcs-browser">https://github.com/AtomicBot-ai/atomic-agent</url>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <releases>
    <release version="0.0.8" date="2026-11-09"/>
  </releases>
</component>
