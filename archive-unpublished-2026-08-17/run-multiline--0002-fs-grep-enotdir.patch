diff --git a/src/tools/os/fs-grep.test.ts b/src/tools/os/fs-grep.test.ts
index c88eda4..0faa668 100644
--- a/src/tools/os/fs-grep.test.ts
+++ b/src/tools/os/fs-grep.test.ts
@@ -4,7 +4,7 @@ import type {
   CommandResult,
 } from "../../sandbox/command-runner.js";
 import type { ToolContext } from "../tool-registry.js";
-import { buildOsFsGrepTool, parseRipgrepJson } from "./fs-grep.js";
+import { buildOsFsGrepTool, parseRipgrepJson, resolveSearchRoot } from "./fs-grep.js";
 
 // A platform-native absolute root: the grep runner is mocked in these tests
 // so the path is never touched on disk, but it must be a valid absolute path
@@ -310,3 +310,34 @@ describe("os.fs.grep", () => {
     expect(capturedArgs[after + 1]).toBe("2");
   });
 });
+
+describe("resolveSearchRoot", () => {
+  // Regression: `path` was handed straight to `cwd`. A cwd must be a
+  // directory, so grepping a single file died with a bare `spawn ENOTDIR`
+  // that named no argument. Seen twice in real runs when the model asked to
+  // count anchors in one file.
+  const dirStat = { isDirectory: () => true };
+  const fileStat = { isDirectory: () => false };
+
+  it("searches a directory from itself", () => {
+    expect(resolveSearchRoot("/work/project", () => dirStat)).toEqual({
+      cwd: "/work/project",
+      target: ".",
+    });
+  });
+
+  it("searches a FILE from its parent directory, never cwd-ing into it", () => {
+    expect(resolveSearchRoot("/work/project/index.html", () => fileStat)).toEqual({
+      cwd: "/work/project",
+      target: "index.html",
+    });
+  });
+
+  it("leaves a missing path alone so ripgrep reports it, not spawn", () => {
+    expect(
+      resolveSearchRoot("/work/gone", () => {
+        throw new Error("ENOENT");
+      }),
+    ).toEqual({ cwd: "/work/gone", target: "." });
+  });
+});
diff --git a/src/tools/os/fs-grep.ts b/src/tools/os/fs-grep.ts
index 1a096d4..66e0efa 100644
--- a/src/tools/os/fs-grep.ts
+++ b/src/tools/os/fs-grep.ts
@@ -1,3 +1,5 @@
+import { statSync } from "node:fs";
+import { basename, dirname } from "node:path";
 import { compressToolResult } from "../../compressor/result-compressor.js";
 import { resolveUserPath } from "./expand-home.js";
 import {
@@ -72,9 +74,15 @@ export function buildOsFsGrepTool(
         });
       }
 
-      const rgArgs = buildRgArgs(args);
+      // `path` may legitimately be a single FILE ("grep this one file"), but
+      // it was passed straight to `cwd`, and a cwd must be a directory — the
+      // spawn then failed with a bare `ENOTDIR` that says nothing about which
+      // argument was wrong. Search from the containing directory and name the
+      // file as the target instead.
+      const { cwd, target } = resolveSearchRoot(args.path);
+      const rgArgs = buildRgArgs(args, target);
       const result = await runCommand(rgPath, rgArgs, {
-        cwd: args.path,
+        cwd,
         timeoutMs: args.timeoutMs,
         signal: ctx.signal,
       });
@@ -194,7 +202,27 @@ function parseArgs(
   };
 }
 
-function buildRgArgs(args: GrepArgs): string[] {
+/**
+ * Split a user-supplied `path` into the directory ripgrep should run in and
+ * the target it should search. A directory searches itself (`.`); a file
+ * searches from its parent so `cwd` is always a real directory.
+ *
+ * A path that does not exist is left alone: ripgrep's own "no such file"
+ * message is far more useful to the caller than an `ENOTDIR` from `spawn`.
+ */
+export function resolveSearchRoot(
+  path: string,
+  statFn: (p: string) => { isDirectory(): boolean } = statSync,
+): { cwd: string; target: string } {
+  try {
+    if (statFn(path).isDirectory()) return { cwd: path, target: "." };
+    return { cwd: dirname(path), target: basename(path) };
+  } catch {
+    return { cwd: path, target: "." };
+  }
+}
+
+function buildRgArgs(args: GrepArgs, target = "."): string[] {
   const rg: string[] = ["--json"];
   if (args.caseInsensitive) rg.push("-i");
   if (args.multiline) {
@@ -207,7 +235,7 @@ function buildRgArgs(args: GrepArgs): string[] {
     rg.push("--glob", g);
   }
   if (args.type) rg.push("--type", args.type);
-  rg.push("--", args.pattern, ".");
+  rg.push("--", args.pattern, target);
   return rg;
 }
 
