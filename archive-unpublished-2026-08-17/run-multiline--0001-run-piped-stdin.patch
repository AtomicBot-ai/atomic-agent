+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { Readable } from "node:stream";
+
+import type { AgentRuntime } from "../runtime/bootstrap.js";
+import type { SessionState } from "../session/session-state.js";
+
+import {
+  RUN_HELP,
+  parseArgs,
+  resolveInitialMessage,
+  runChatLoop,
+} from "./run-agent.js";
+
+function withTempDir(fn: (dir: string) => void | Promise<void>): Promise<void> {
+  const dir = mkdtempSync(join(tmpdir(), "run-agent-test-"));
+  return Promise.resolve(fn(dir)).finally(() => {
+    rmSync(dir, { recursive: true, force: true });
+  });
+}
+
+const noStdin = (): Promise<string> => {
+  throw new Error("stdin should not be read");
+};
+
+describe("parseArgs", () => {
+  it("keeps the existing flags working", () => {
+    const parsed = parseArgs([
+      "--cwd",
+      "/tmp",
+      "--max-steps",
+      "7",
+      "--no-approval",
+    ]);
+    expect(parsed).toEqual({
+      workingDir: resolve("/tmp"),
+      maxSteps: 7,
+      noApproval: true,
+      promptText: null,
+      promptFile: null,
+    });
+  });
+
+  it("defaults the prompt fields to null so no turn is seeded", () => {
+    const parsed = parseArgs([]);
+    expect(parsed).toMatchObject({ promptText: null, promptFile: null });
+  });
+
+  it("accepts --prompt and --prompt-file", () => {
+    expect(parseArgs(["--prompt", "hi there"])).toMatchObject({
+      promptText: "hi there",
+      promptFile: null,
+    });
+    expect(parseArgs(["--prompt-file", "brief.md"])).toMatchObject({
+      promptText: null,
+      promptFile: "brief.md",
+    });
+  });
+
+  it("rejects --prompt together with --prompt-file", () => {
+    expect(parseArgs(["--prompt", "a", "--prompt-file", "b.md"])).toEqual({
+      error: "--prompt and --prompt-file are mutually exclusive",
+    });
+  });
+
+  it("rejects prompt flags with no value", () => {
+    expect(parseArgs(["--prompt"])).toEqual({
+      error: "--prompt requires a value",
+    });
+    expect(parseArgs(["--prompt-file"])).toEqual({
+      error: "--prompt-file requires a value",
+    });
+  });
+
+  it("treats --help / -h as help rather than an unknown flag", () => {
+    // Regression: `run --help` used to exit 2 with "unknown flag: --help",
+    // which is how an operator discovers the line-per-turn stdin contract.
+    expect(parseArgs(["--help"])).toEqual({ help: true });
+    expect(parseArgs(["-h"])).toEqual({ help: true });
+  });
+
+  it("still reports genuinely unknown flags", () => {
+    expect(parseArgs(["--nope"])).toEqual({ error: "unknown flag: --nope" });
+  });
+
+  it("documents the multi-line stdin pitfall in the help text", () => {
+    expect(RUN_HELP).toContain("--prompt-file");
+    expect(RUN_HELP).toContain("one message per line");
+  });
+});
+
+/**
+ * The chat loop only needs `runTurn` from the runtime, so the fake records
+ * the exact message text of every turn and hands the session straight back.
+ */
+function fakeRuntime(): { runtime: AgentRuntime; messages: string[] } {
+  const messages: string[] = [];
+  const runtime = {
+    runTurn: async (session: SessionState, message: string) => {
+      messages.push(message);
+      return { session };
+    },
+  } as unknown as AgentRuntime;
+  return { runtime, messages };
+}
+
+const BRIEF = "# BUILD BRIEF\n\nStep one: scaffold.\nStep two: verify.";
+
+describe("runChatLoop message framing", () => {
+  let stdout: ReturnType<typeof vi.spyOn>;
+  let stderr: ReturnType<typeof vi.spyOn>;
+
+  beforeEach(() => {
+    // The loop writes one line per turn to stdout and the `you> ` prompt to
+    // stderr; swallow both so test output stays readable.
+    stdout = vi.spyOn(process.stdout, "write").mockReturnValue(true);
+    stderr = vi.spyOn(process.stderr, "write").mockReturnValue(true);
+  });
+  afterEach(() => {
+    stdout.mockRestore();
+    stderr.mockRestore();
+  });
+
+  const drive = async (
+    opts: { initialMessage?: string; stdin?: string },
+  ): Promise<string[]> => {
+    const { runtime, messages } = fakeRuntime();
+    await runChatLoop({
+      runtime,
+      initialSession: { status: "pending" } as SessionState,
+      maxSteps: 4,
+      controller: new AbortController(),
+      ...(opts.initialMessage === undefined
+        ? {}
+        : { initialMessage: opts.initialMessage }),
+      input: Readable.from([opts.stdin ?? ""]),
+    });
+    return messages;
+  };
+
+  it("keeps every piped line instead of dropping all but the first", async () => {
+    // Regression: readline drains a whole chunk the moment it lands, and
+    // `rl.question` only takes one line, so a bulk pipe used to run turn 0
+    // and silently discard the rest. Before the queue this returned
+    // exactly ["# BUILD BRIEF"].
+    const messages = await drive({ stdin: `${BRIEF}\n` });
+    expect(messages).toEqual([
+      "# BUILD BRIEF",
+      "Step one: scaffold.",
+      "Step two: verify.",
+    ]);
+    expect(messages[0]).not.toContain("scaffold");
+  });
+
+  it("delivers initialMessage as a single turn with newlines intact", async () => {
+    const messages = await drive({ initialMessage: BRIEF });
+    expect(messages).toEqual([BRIEF]);
+    expect(messages[0]).toContain("scaffold");
+    expect(messages[0]).toContain("verify");
+  });
+
+  it("sends initialMessage before stdin, then keeps chatting", async () => {
+    // Invariant #6: this is not a one-shot mode — the session stays a
+    // multi-turn chat, the seed is just turn 0.
+    const messages = await drive({
+      initialMessage: BRIEF,
+      stdin: "follow up\n",
+    });
+    expect(messages).toEqual([BRIEF, "follow up"]);
+  });
+
+  it("skips the seeded turn when no prompt flag was given", async () => {
+    expect(await drive({ stdin: "hello\n" })).toEqual(["hello"]);
+  });
+
+  it("returns instead of hanging when the input stream is already ended", async () => {
+    // `--prompt-file -` drains stdin before the loop starts, so readline's
+    // `close` fires before the loop can attach a one-shot listener. The
+    // seeded turn must run and the loop must then exit at EOF.
+    const drained = Readable.from(["already read\n"]);
+    for await (const _chunk of drained) {
+      // consume to end
+    }
+    const { runtime, messages } = fakeRuntime();
+    await runChatLoop({
+      runtime,
+      initialSession: { status: "pending" } as SessionState,
+      maxSteps: 1,
+      controller: new AbortController(),
+      initialMessage: BRIEF,
+      input: drained,
+    });
+    expect(messages).toEqual([BRIEF]);
+  });
+
+  it("stops at /quit without seeding an extra turn", async () => {
+    expect(await drive({ stdin: "one\n/quit\ntwo\n" })).toEqual(["one"]);
+  });
+});
+
+describe("resolveInitialMessage", () => {
+  it("seeds no message when neither flag is given", async () => {
+    await expect(
+      resolveInitialMessage({ promptText: null, promptFile: null }, noStdin),
+    ).resolves.toEqual({ message: null });
+  });
+
+  it("passes --prompt through, trimmed", async () => {
+    await expect(
+      resolveInitialMessage(
+        { promptText: "  build the thing  ", promptFile: null },
+        noStdin,
+      ),
+    ).resolves.toEqual({ message: "build the thing" });
+  });
+
+  it("rejects a whitespace-only --prompt instead of seeding an empty turn", async () => {
+    await expect(
+      resolveInitialMessage({ promptText: "   ", promptFile: null }, noStdin),
+    ).resolves.toEqual({ error: "--prompt is empty" });
+  });
+
+  it("reads a multi-line file as ONE message with newlines intact", async () => {
+    await withTempDir(async (dir) => {
+      const path = join(dir, "brief.md");
+      const brief = "# BUILD BRIEF\n\nLine two.\n- bullet three\n";
+      writeFileSync(path, brief);
+      const result = await resolveInitialMessage(
+        { promptText: null, promptFile: path },
+        noStdin,
+      );
+      // This is the whole point of the flag: the model must receive every
+      // line, not just the heading.
+      expect(result).toEqual({
+        message: "# BUILD BRIEF\n\nLine two.\n- bullet three",
+      });
+      if ("message" in result && result.message) {
+        expect(result.message.split("\n")).toHaveLength(4);
+      }
+    });
+  });
+
+  it("reads all of stdin for `-`", async () => {
+    const result = await resolveInitialMessage(
+      { promptText: null, promptFile: "-" },
+      async () => "first line\nsecond line\n",
+    );
+    expect(result).toEqual({ message: "first line\nsecond line" });
+  });
+
+  it("errors on an empty prompt file", async () => {
+    await withTempDir(async (dir) => {
+      const path = join(dir, "empty.md");
+      writeFileSync(path, "\n  \n");
+      await expect(
+        resolveInitialMessage({ promptText: null, promptFile: path }, noStdin),
+      ).resolves.toEqual({ error: `--prompt-file ${path} is empty` });
+    });
+  });
+
+  it("errors on empty stdin, naming stdin rather than `-`", async () => {
+    await expect(
+      resolveInitialMessage(
+        { promptText: null, promptFile: "-" },
+        async () => "",
+      ),
+    ).resolves.toEqual({ error: "--prompt-file stdin is empty" });
+  });
+
+  it("errors with the resolved path when the file is missing", async () => {
+    const result = await resolveInitialMessage(
+      { promptText: null, promptFile: "no-such-brief.md" },
+      noStdin,
+    );
+    expect(result).toMatchObject({});
+    expect("error" in result && result.error).toContain(
+      resolve("no-such-brief.md"),
+    );
+    expect("error" in result && result.error).toContain("ENOENT");
+  });
+});
