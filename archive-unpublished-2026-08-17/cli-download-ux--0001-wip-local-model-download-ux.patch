+/**
+ * Persist a provider's chat-model shortlist and its live model in one
+ * write. Index 0 is authoritative: it is mirrored into
+ * `defaultChatModel` so provider construction, the route line and the
+ * row `active` flag all keep reading a single field. Writing both in
+ * one pass keeps them from ever disagreeing on disk.
+ */
+export function setProviderChatModelSelectionInConfig(
+  providerId: string,
+  selected: readonly string[],
+): void {
+  const cleaned = selected.map((m) => m.trim()).filter((m) => m.length > 0);
+  if (cleaned.length === 0) {
+    throw new LlmRemoveProviderError("chat model selection is empty");
+  }
+  if (cleaned.length > MAX_SELECTED_CHAT_MODELS) {
+    throw new LlmRemoveProviderError(
+      `chat model selection exceeds ${MAX_SELECTED_CHAT_MODELS} entries`,
+    );
+  }
+  const path = getConfig().paths.userConfigFile;
+  const file = ensureUserConfigFileSync(path);
+  const llm = readLlmBlockOrDefault(file);
+  let found = false;
+  const providers = llm.providers.map((provider) => {
+    if (provider.id !== providerId) return provider;
+    found = true;
+    return {
+      ...provider,
+      defaultChatModel: cleaned[0]!,
+      selectedChatModels: cleaned,
+    };
+  });
+  if (!found) {
+    throw new LlmRemoveProviderError(`provider "${providerId}" is not configured`);
+  }
+  writeUserConfigFileSync(path, {
+    ...file,
+    llm: { ...llm, providers },
+  });
+  resetConfigCache();
+}
