+import { describe, expect, it } from "vitest";
+
+import {
+  createOpenAiStreamConsumer,
+  mergeToolCallName,
+} from "./openai-stream-consumer.js";
+import type { StreamFinalResult } from "../completion-types.js";
+
+/** Wrap SSE frames in a ReadableStream the way a real `fetch` body arrives. */
+function sseBody(frames: readonly string[]): ReadableStream<Uint8Array> {
+  const encoder = new TextEncoder();
+  return new ReadableStream({
+    start(controller) {
+      for (const frame of frames) {
+        controller.enqueue(encoder.encode(`data: ${frame}\n\n`));
+      }
+      controller.enqueue(encoder.encode("data: [DONE]\n\n"));
+      controller.close();
+    },
+  });
+}
+
+/** Drive the consumer to completion and return its final result. */
+async function consume(
+  frames: readonly string[],
+): Promise<StreamFinalResult | undefined> {
+  const consumer = createOpenAiStreamConsumer("delta_reasoning");
+  const iterator = consumer.consume(sseBody(frames), undefined);
+  let result: StreamFinalResult | undefined;
+  while (true) {
+    const next = await iterator.next();
+    if (next.done) {
+      result = next.value as StreamFinalResult | undefined;
+      break;
+    }
+  }
+  return result;
+}
+
+function toolCallFrame(
+  index: number,
+  fn: { name?: string; arguments?: string },
+): string {
+  return JSON.stringify({
+    choices: [{ index: 0, delta: { tool_calls: [{ index, function: fn }] } }],
+  });
+}
+
+describe("mergeToolCallName", () => {
+  it("takes the first fragment", () => {
+    expect(mergeToolCallName("", "reply")).toBe("reply");
+  });
+
+  it("ignores a provider that repeats the whole name every chunk", () => {
+    // aimlapi does this; appending produced `replyreplyreply…` and the
+    // registry check then failed the whole turn.
+    expect(mergeToolCallName("reply", "reply")).toBe("reply");
+  });
+
+  it("still concatenates genuinely fragmented names", () => {
+    expect(mergeToolCallName("os.fs", ".read")).toBe("os.fs.read");
+  });
+
+  it("collapses an overlapping repeat rather than doubling it", () => {
+    expect(mergeToolCallName("reply", "ly")).toBe("reply");
+    expect(mergeToolCallName("rep", "reply")).toBe("reply");
+  });
+});
+
+describe("openai stream consumer tool calls", () => {
+  it("keeps the tool name intact when the provider repeats it per chunk", async () => {
+    const result = await consume([
+      toolCallFrame(0, { name: "reply", arguments: '{"te' }),
+      toolCallFrame(0, { name: "reply", arguments: 'xt":"' }),
+      toolCallFrame(0, { name: "reply", arguments: 'hi"}' }),
+    ]);
+    expect(result?.toolCalls?.[0]?.function.name).toBe("reply");
+    expect(result?.toolCalls?.[0]?.function.arguments).toBe('{"text":"hi"}');
+  });
+
+  it("handles the standard shape where the name arrives once", async () => {
+    const result = await consume([
+      toolCallFrame(0, { name: "reply", arguments: "" }),
+      toolCallFrame(0, { arguments: '{"text":"hi"}' }),
+    ]);
+    expect(result?.toolCalls?.[0]?.function.name).toBe("reply");
+    expect(result?.toolCalls?.[0]?.function.arguments).toBe('{"text":"hi"}');
+  });
+
+  it("keeps parallel tool calls separate", async () => {
+    const result = await consume([
+      toolCallFrame(0, { name: "os.fs.read", arguments: "{}" }),
+      toolCallFrame(1, { name: "os.fs.read", arguments: "{}" }),
+      toolCallFrame(1, { name: "os.fs.read" }),
+    ]);
