+import { describe, expect, it } from "vitest";
+
+import type { AtomicAgentConfig } from "../../../config/config-schema.js";
+import type { LlmProvider } from "../llm-provider.js";
+import type { ProviderRegistry } from "./provider-registry.js";
+import {
+  isFusionEnabled,
+  resolveProviderForRole,
+  resolveRoleProviderId,
+} from "./resolve-role-provider.js";
+
+function provider(id: string): LlmProvider {
+  return { id } as unknown as LlmProvider;
+}
+
+/** Minimal registry stand-in: the resolver only uses these two members. */
+function registry(active: string, ids: readonly string[]): ProviderRegistry {
+  return {
+    get activeText() {
+      return provider(active);
+    },
+    getProvider: (id: string) =>
+      ids.includes(id) ? provider(id) : undefined,
+  } as unknown as ProviderRegistry;
+}
+
+function config(fusion?: {
+  enabled: boolean;
+  orchestrator: string;
+  executor: string;
+}): AtomicAgentConfig {
+  return {
+    llm: {
+      activeTextProvider: "local-llama",
+      activeEmbeddingProvider: "local-llama",
+      providers: [],
+      ...(fusion ? { fusion } : {}),
+    },
+  } as unknown as AtomicAgentConfig;
+}
+
+const PAIRING = {
+  enabled: true,
+  orchestrator: "aimlapi",
+  executor: "local-llama",
+};
+
+describe("isFusionEnabled", () => {
+  it("is off when there is no fusion block", () => {
+    expect(isFusionEnabled(config())).toBe(false);
+  });
+
+  it("is off when configured but switched off", () => {
+    expect(isFusionEnabled(config({ ...PAIRING, enabled: false }))).toBe(false);
+  });
+
+  it("is off when both roles name the same provider", () => {
+    expect(
+      isFusionEnabled(
+        config({ enabled: true, orchestrator: "a", executor: "a" }),
+      ),
+    ).toBe(false);
+  });
+
+  it("is on for a real pairing", () => {
+    expect(isFusionEnabled(config(PAIRING))).toBe(true);
+  });
+});
+
+describe("resolveRoleProviderId", () => {
+  it("maps each role to its configured provider", () => {
+    expect(resolveRoleProviderId(config(PAIRING), "orchestrator")).toBe("aimlapi");
+    expect(resolveRoleProviderId(config(PAIRING), "executor")).toBe("local-llama");
+  });
+
+  it("returns null without a role, so single-model calls are untouched", () => {
+    expect(resolveRoleProviderId(config(PAIRING), undefined)).toBeNull();
+  });
+
+  it("returns null when fusion is off, even with a role", () => {
+    expect(resolveRoleProviderId(config(), "orchestrator")).toBeNull();
+  });
+});
+
+describe("resolveProviderForRole", () => {
+  const reg = registry("local-llama", ["local-llama", "aimlapi"]);
+
+  it("gives each role its own live provider", () => {
+    expect(resolveProviderForRole(config(PAIRING), reg, "orchestrator").id).toBe(
+      "aimlapi",
+    );
+    expect(resolveProviderForRole(config(PAIRING), reg, "executor").id).toBe(
+      "local-llama",
+    );
+  });
+
+  it("resolves both roles without disturbing the active provider", () => {
+    // The peers must coexist: `swapActive` closes the provider it
+    // replaces, so implementing roles as a swap would tear down the
+    // other half of the pairing mid-turn.
+    const before = reg.activeText.id;
+    resolveProviderForRole(config(PAIRING), reg, "orchestrator");
+    resolveProviderForRole(config(PAIRING), reg, "executor");
+    expect(reg.activeText.id).toBe(before);
+  });
+
+  it("falls back to the active provider when fusion is off", () => {
+    expect(resolveProviderForRole(config(), reg, "orchestrator").id).toBe(
