@@ -0,0 +1,61 @@
+import type { AtomicAgentConfig } from "../../../config/config-schema.js";
+import type { LlmProvider } from "../llm-provider.js";
+import type { ProviderRegistry } from "./provider-registry.js";
+
+/**
+ * Which half of a Fusion pairing an inference belongs to.
+ *
+ * - `orchestrator` — plans the work (typically a cloud model).
+ * - `executor` — carries the plan out (typically the local model).
+ *
+ * Calls that are not part of a Fusion turn pass no role at all and keep
+ * using the single active text provider.
+ */
+export type LlmRole = "orchestrator" | "executor";
+
+/**
+ * True when a usable Fusion pairing is configured: switched on, and both
+ * roles naming providers that differ. Config parsing already rejects
+ * unknown ids and self-pairings, so this is only re-checking the switch
+ * plus the shape, cheaply, on the per-inference path.
+ */
+export function isFusionEnabled(config: AtomicAgentConfig): boolean {
+  const fusion = config.llm?.fusion;
+  return Boolean(
+    fusion?.enabled && fusion.orchestrator && fusion.executor &&
+      fusion.orchestrator !== fusion.executor,
+  );
+}
+
+/**
+ * Provider id for a Fusion role, or `null` when Fusion is off / no role
+ * was requested.
+ */
+export function resolveRoleProviderId(
+  config: AtomicAgentConfig,
+  role: LlmRole | undefined,
+): string | null {
+  if (!role || !isFusionEnabled(config)) return null;
+  const fusion = config.llm!.fusion!;
+  return role === "orchestrator" ? fusion.orchestrator : fusion.executor;
+}
+
+/**
+ * Live provider for a role.
+ *
+ * Falls back to the active text provider whenever Fusion is off, no role
+ * was asked for, or the configured id is not in the registry. The
+ * fallback is deliberate: a Fusion pairing whose executor failed to
+ * build should degrade to single-model operation rather than abort the
+ * turn, and the registry is rebuilt from config on provider edits
+ * (`registerMissingFromConfig`), so a transient gap is recoverable.
+ */
+export function resolveProviderForRole(
+  config: AtomicAgentConfig,
+  registry: ProviderRegistry,
+  role: LlmRole | undefined,
+): LlmProvider {
+  const id = resolveRoleProviderId(config, role);
+  if (id === null) return registry.activeText;
+  return registry.getProvider(id) ?? registry.activeText;
+}
