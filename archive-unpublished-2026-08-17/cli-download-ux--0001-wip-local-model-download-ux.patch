  * `reasoning_content` channel when present and falling back to inline
  * `<think>...</think>` extraction for classic llama-server builds.
  */
+/** Longest tool name we will echo back verbatim in an error. */
+const MAX_ECHOED_TOOL_NAME = 48;
+
+/**
+ * Human-readable message for a tool the registry does not know.
+ *
+ * The raw name is echoed so the cause is visible, but bounded: a
+ * provider that repeats a streamed `function.name` fragment can produce
+ * an arbitrarily long string, and pasting all of it into the error box
+ * buries the actual problem. When the mangled name still contains a
+ * real tool we say so outright, because that is the common case and
+ * points straight at the transport rather than at the operator's
+ * config.
+ */
+function describeUnknownTool(name: string, registry: ToolRegistry): string {
+  const shown =
+    name.length > MAX_ECHOED_TOOL_NAME
+      ? `${name.slice(0, MAX_ECHOED_TOOL_NAME)}… (${name.length} chars)`
+      : name;
+  const known = registry.list().map((t) => t.name);
+  const repeated = known.find(
+    (candidate) => candidate.length > 0 && name === candidate.repeat(name.length / candidate.length),
+  );
+  if (repeated) {
+    return (
+      `the model asked for "${shown}", which looks like "${repeated}" repeated — ` +
+      `the provider streamed the tool name in duplicate chunks`
+    );
+  }
+  const suggestion = known
+    .filter((candidate) => name.includes(candidate) || candidate.includes(name))
+    .slice(0, 3);
+  const hint =
+    suggestion.length > 0
+      ? ` Did you mean ${suggestion.map((s) => `"${s}"`).join(", ")}?`
+      : ` Registered tools: ${known.slice(0, 8).join(", ")}${known.length > 8 ? ", …" : ""}.`;
+  return `tool not registered in this agent: "${shown}".${hint}`;
+}
+
 function resolveReasoning(
   completion: CompletionResult,
   profile: ModelProfile,
