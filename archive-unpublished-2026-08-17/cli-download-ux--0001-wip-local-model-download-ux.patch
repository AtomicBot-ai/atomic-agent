+import { render } from "ink-testing-library";
+import { describe, expect, it } from "vitest";
+import React from "react";
+
+import { fakeSession } from "../test-fixtures.js";
+import { createInitialTuiState, type RunMode, type TuiState } from "../tui-state.js";
+import { RunModeBar, selectStatusBarDetail, StatusBar } from "./status-bar.js";
+
+const ANSI = /\[[0-9;]*m/g;
+
+function frame(patch: Partial<TuiState>): string {
+  const base = createInitialTuiState(fakeSession());
+  const { lastFrame, unmount } = render(<StatusBar state={{ ...base, ...patch }} />);
+  const out = (lastFrame() ?? "").replace(ANSI, "");
+  unmount();
+  return out;
+}
+
+/** The Run strip is its own row now, mirroring SubTabBar. */
+function runBarFrame(patch: Partial<TuiState>): string {
+  const base = createInitialTuiState(fakeSession());
+  const { lastFrame, unmount } = render(<RunModeBar state={{ ...base, ...patch }} />);
+  const out = (lastFrame() ?? "").replace(ANSI, "");
+  unmount();
+  return out;
+}
+
+describe("StatusBar Run strip", () => {
+  it("shows the Run inner modes on their own row, below the sections", () => {
+    expect(frame({ uiMode: "chat", runMode: "local" })).toContain("Run");
+    const bar = runBarFrame({ uiMode: "chat", runMode: "local" });
+    expect(bar).toContain("Local");
+    expect(bar).toContain("Cloud");
+    expect(bar).toContain("Fusion");
+  });
+
+  it("marks the active mode the same way the sub-tab bar does", () => {
+    const bar = runBarFrame({ uiMode: "chat", runMode: "cloud" });
+    expect(bar).toContain("▸ Cloud");
+    // Inactive modes carry no marker, exactly like SubTabBar.
+    expect(bar).not.toContain("▸ Local");
+  });
+
+  it("hides the Run row in the debug sections, which have SubTabBar", () => {
+    expect(frame({ uiMode: "debug", activeTab: "llm" })).toContain("Manage");
+    expect(runBarFrame({ uiMode: "debug", activeTab: "llm" }).trim()).toBe("");
+  });
+
+  it("stays a single row in every mode", () => {
+    // The row height is baked into the chat viewport budget, and Ink
+    // overlaps an oversized frame instead of clipping it.
+    for (const runMode of ["local", "cloud", "fusion"] as RunMode[]) {
+      const lines = runBarFrame({ uiMode: "chat", runMode })
+        .split("\n")
+        .filter((l) => l.trim().length > 0);
+      expect(lines).toHaveLength(1);
+    }
+  });
+});
+
+describe("selectStatusBarDetail", () => {
+  it("shows everything on a wide terminal", () => {
+    expect(selectStatusBarDetail(140)).toEqual({
+      showAllRunModes: true,
+      showSession: true,
+    });
+  });
+
+  it("drops the session id before the Run modes", () => {
+    // The session id is reference information; which engine is serving
+    // is not.
+    const at100 = selectStatusBarDetail(100);
+    expect(at100.showAllRunModes).toBe(true);
+    expect(at100.showSession).toBe(false);
+  });
+
+  it("collapses to the active Run mode on a standard 80-column terminal", () => {
+    expect(selectStatusBarDetail(80)).toEqual({
+      showAllRunModes: false,
+      showSession: false,
+    });
