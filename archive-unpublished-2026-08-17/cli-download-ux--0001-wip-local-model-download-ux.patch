+
+  describe("fusion pairing", () => {
+    function parseWithFusion(fusion: unknown) {
+      return parseUserConfigFile({
+        version: USER_CONFIG_VERSION,
+        llm: {
+          activeTextProvider: "aimlapi",
+          activeEmbeddingProvider: "aimlapi",
+          toolTransport: "auto",
+          providers: [
+            { id: "aimlapi", kind: "aimlapi", defaultChatModel: "gpt-5" },
+            { id: "local-llama", kind: "llama-server", url: "http://127.0.0.1:8080" },
+          ],
+          fusion,
+        },
+      });
+    }
+
+    it("round-trips an orchestrator/executor pairing", () => {
+      const parsed = parseWithFusion({
+        enabled: true,
+        orchestrator: "aimlapi",
+        executor: "local-llama",
+      });
+      expect(parsed.llm?.fusion).toEqual({
+        enabled: true,
+        orchestrator: "aimlapi",
+        executor: "local-llama",
+      });
+    });
+
+    it("is absent by default", () => {
+      expect(parseWithFusion(undefined).llm?.fusion).toBeUndefined();
+    });
+
+    it("rejects a role naming an unconfigured provider", () => {
+      // Caught here rather than mid-turn, where a dangling id would look
+      // like a model failure instead of a config one.
+      expect(() =>
+        parseWithFusion({
+          enabled: true,
+          orchestrator: "nope",
+          executor: "local-llama",
+        }),
+      ).toThrow(/orchestrator/);
+    });
+
+    it("rejects pairing a provider with itself", () => {
+      expect(() =>
+        parseWithFusion({
+          enabled: true,
+          orchestrator: "aimlapi",
+          executor: "aimlapi",
+        }),
+      ).toThrow(/different/);
+    });
+
+    it("rejects a malformed block instead of dropping it", () => {
+      expect(() => parseWithFusion({ enabled: "yes" })).toThrow();
+      expect(() => parseWithFusion([])).toThrow();
+    });
+  });
+
+  describe("selectedChatModels (multi-select shortlist)", () => {
+    function parseWith(selectedChatModels: unknown) {
+      return parseUserConfigFile({
+        version: USER_CONFIG_VERSION,
+        llm: {
+          activeTextProvider: "aimlapi",
+          activeEmbeddingProvider: "aimlapi",
+          toolTransport: "auto",
+          providers: [
+            {
+              id: "aimlapi",
+              kind: "aimlapi",
+              defaultChatModel: "openai/gpt-5-2",
+              selectedChatModels,
+            },
+          ],
+        },
+      });
+    }
+
+    it("round-trips the shortlist in selection order", () => {
+      const parsed = parseWith(["openai/gpt-5-2", "anthropic/claude", "x/y"]);
+      expect(
+        parsed.llm?.providers.find((p) => p.id === "aimlapi")
+          ?.selectedChatModels,
+      ).toEqual(["openai/gpt-5-2", "anthropic/claude", "x/y"]);
+    });
+
+    it("collapses duplicates to their first position", () => {
+      const parsed = parseWith(["a", "b", "a"]);
+      expect(
+        parsed.llm?.providers.find((p) => p.id === "aimlapi")
+          ?.selectedChatModels,
+      ).toEqual(["a", "b"]);
+    });
+
+    it("is optional — entries without it still parse", () => {
+      const parsed = parseWith(undefined);
+      expect(
+        parsed.llm?.providers.find((p) => p.id === "aimlapi")
+          ?.selectedChatModels,
+      ).toBeUndefined();
+    });
+
+    it("rejects malformed entries instead of silently dropping them", () => {
+      expect(() => parseWith(["ok", ""])).toThrow();
+      expect(() => parseWith("not-an-array")).toThrow();
+      expect(() => parseWith([1, 2])).toThrow();
+    });
+
+    it("rejects a shortlist longer than the cap", () => {
+      const tooMany = Array.from({ length: 9 }, (_, i) => `model-${i}`);
+      expect(() => parseWith(tooMany)).toThrow();
+    });
+  });
 });
