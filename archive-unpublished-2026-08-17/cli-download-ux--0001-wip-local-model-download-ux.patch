index 0000000..6ef0bec
--- /dev/null
+++ b/scripts/key-probe.mjs
@@ -0,0 +1,69 @@
+#!/usr/bin/env node
+/**
+ * Raw key probe.
+ *
+ * Prints the exact bytes your terminal sends for each keypress, plus how
+ * Ink parses them. Use it when a binding "does nothing": the usual cause
+ * is not the app but the terminal emulator claiming the combination for
+ * itself (macOS Terminal.app maps Shift+Up/Down to scrollback, tmux
+ * without `xterm-keys` drops modified arrows, and so on) — in which case
+ * the sequence never reaches the process at all and nothing shows here.
+ *
+ *   node scripts/key-probe.mjs
+ *
+ * Press the combinations you care about, then Ctrl+C to exit.
+ */
+import process from "node:process";
+
+const EXPECTED = new Map([
+  ["[1;2A", "Shift+Up"],
+  ["[1;2B", "Shift+Down"],
+  ["[1;2C", "Shift+Right"],
+  ["[1;2D", "Shift+Left"],
+  ["[Z", "Shift+Tab"],
+  ["[A", "Up (no modifier)"],
+  ["[B", "Down (no modifier)"],
+  ["[C", "Right (no modifier)"],
+  ["[D", "Left (no modifier)"],
+]);
+
+function describe(raw) {
+  const known = EXPECTED.get(raw);
+  if (known) return known;
+  if (raw === "") return "Ctrl+C";
+  if (/^[A-Z]$/.test(raw)) return `Shift+${raw} (arrives as a capital letter)`;
+  if (/^[a-z]$/.test(raw)) return `${raw} (plain letter)`;
+  return "unrecognised";
+}
+
+function visible(raw) {
+  return JSON.stringify(raw).slice(1, -1);
+}
+
+if (!process.stdin.isTTY) {
+  console.error("key-probe needs a real terminal (a TTY).");
+  process.exit(1);
+}
+
+console.log("Key probe — press keys to see what your terminal actually sends.");
+console.log("Try: Shift+Up, Shift+Down, Shift+Left, Shift+Right, Shift+W, Shift+S.");
+console.log("Nothing printed = your terminal swallowed it before the app saw it.");
+console.log("Ctrl+C to exit.\n");
+
+process.stdin.setRawMode(true);
+process.stdin.resume();
+process.stdin.setEncoding("utf8");
+
+process.stdin.on("data", (chunk) => {
+  if (chunk === "") {
+    console.log("\nbye.");
+    process.exit(0);
+  }
+  const bytes = Buffer.from(chunk, "utf8")
+    .toString("hex")
+    .replace(/(..)/g, "$1 ")
+    .trim();
+  console.log(
+    `raw=${JSON.stringify(visible(chunk)).padEnd(18)} hex=[${bytes.padEnd(20)}] -> ${describe(chunk)}`,
+  );
+});
