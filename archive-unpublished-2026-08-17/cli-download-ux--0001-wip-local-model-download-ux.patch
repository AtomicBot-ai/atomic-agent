+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { waitForHealthOkWithLog } from "./daemon-lifecycle.js";
+import { resolveLogFilePath } from "./backend-paths.js";
+
+/**
+ * Fake `/health` responses in sequence; the last entry repeats. `null`
+ * means the request fails outright (server not listening yet).
+ */
+function stubHealth(sequence: ReadonlyArray<"ok" | "loading" | null>): void {
+  let i = 0;
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async () => {
+      const step = sequence[Math.min(i, sequence.length - 1)];
+      i += 1;
+      if (step === null) throw new Error("ECONNREFUSED");
+      if (step === "ok") {
+        return { ok: true, json: async () => ({ status: "ok" }) };
+      }
+      return { ok: false, json: async () => ({ status: "loading model" }) };
+    }),
+  );
+}
+
+describe("waitForHealthOkWithLog", () => {
+  let dataDir: string;
+
+  beforeEach(() => {
+    dataDir = mkdtempSync(join(tmpdir(), "atomic-daemon-wait-"));
+    writeFileSync(resolveLogFilePath(dataDir), "log line\n", "utf-8");
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    rmSync(dataDir, { recursive: true, force: true });
+  });
+
+  it("returns as soon as the server reports ok", async () => {
