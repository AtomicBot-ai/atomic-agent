@@ -0,0 +1,66 @@
+import { describe, expect, it } from "vitest";
+import { render } from "ink-testing-library";
+import React from "react";
+import { LocalModelsPanel } from "./local-models-panel.js";
+import {
+  createInitialLocalModelsPanelState,
+  type LocalModelsPanelState,
+} from "../local-models/local-models-panel-state.js";
+import { LOCAL_MODELS_CATALOG } from "../../local-llm/models-catalog.js";
+
+/**
+ * ATO-6 regression: while a model is downloading, the panel must render
+ * exactly ONE progress bar — the detailed download banner. The inline
+ * per-row bar used to render a second `[==== ]` for the same download,
+ * so the operator saw two/three bars stacked for one file.
+ *
+ * A "progress bar" here is a run of two or more `=` fill characters; the
+ * availability/RAM badges (`[gguf]`, `[✓ RAM]`) never contain runs of
+ * `=`, so counting `={2,}` runs counts bars.
+ */
+function panelMidDownload(): LocalModelsPanelState {
+  const base = createInitialLocalModelsPanelState();
+  const rows = LOCAL_MODELS_CATALOG.map((def) => ({
+    id: def.id,
+    def,
+    downloaded: false,
+    active: false,
+    mmprojStatus: "n/a" as const,
+  }));
+  const target = rows[0]!;
+  return {
+    ...base,
+    rows,
+    cursor: 0,
+    // 50% so both the banner bar and the (removed) row bar would have fill.
+    pull: {
+      kind: "chat",
+      modelId: target.id,
+      label: `${target.def.name} (gguf)`,
+      percent: 50,
+      transferredBytes: 5_000_000_000,
+      totalBytes: 10_000_000_000,
+      bytesPerSec: 12 * 1024 * 1024,
+      error: null,
+    },
+  };
+}
+
+describe("LocalModelsPanel download progress", () => {
+  it("renders exactly one progress bar while downloading", () => {
+    const { lastFrame } = render(
+      <LocalModelsPanel panel={panelMidDownload()} maxRows={24} />,
+    );
+    const frame = lastFrame() ?? "";
+    const bars = frame.match(/={2,}/g) ?? [];
+    expect(bars.length).toBe(1);
+  });
+
+  it("shows the live download speed in the banner", () => {
+    const { lastFrame } = render(
+      <LocalModelsPanel panel={panelMidDownload()} maxRows={24} />,
+    );
+    const frame = lastFrame() ?? "";
+    expect(frame).toMatch(/MB\/s/);
+  });
+});
