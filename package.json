{
  "name": "atomic-agent",
  "version": "0.1.0",
  "description": "Lightweight local operator agent (browser + OS) runtime for Tauri apps. Connects to an external llama.cpp server via HTTP and exposes a sidecar NDJSON protocol plus a debug CLI.",
  "type": "module",
  "main": "dist/sidecar/index.js",
  "bin": {
    "atomic-agent": "dist/cli/index.js",
    "atomic-agent-sidecar": "dist/sidecar/main.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "cli": "node --enable-source-maps dist/cli/index.js",
    "sidecar": "node --enable-source-maps dist/sidecar/main.js",
    "dev:cli": "tsx src/cli/index.ts",
    "dev:sidecar": "tsx src/sidecar/main.ts",
    "bundle:fetch-assets": "tsx scripts/fetch-assets.ts",
    "bundle:build-binary": "tsx scripts/build-binary.ts",
    "bundle:package": "tsx scripts/package-bundle.ts",
    "bundle:matrix": "tsx scripts/print-matrix.ts"
  },
  "dependencies": {
    "@types/marked": "^5.0.2",
    "better-sqlite3": "^11.5.0",
    "cli-highlight": "^2.1.11",
    "clipboardy": "^5.3.1",
    "fuzzysort": "^3.1.0",
    "ink": "^7.0.1",
    "marked": "^18.0.2",
    "node-notifier": "^10.0.1",
    "playwright-core": "^1.59.1",
    "react": "^19.2.5",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.12.2",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "volta": {
    "node": "22.22.2"
  }
}
