{
  "name": "atomic-agent",
  "version": "0.1.51",
  "description": "Lightweight local operator agent (browser + OS) runtime for Tauri apps. Connects to an external llama.cpp server via HTTP and exposes a sidecar NDJSON protocol plus a debug CLI.",
  "license": "MIT",
  "type": "module",
  "main": "dist/sidecar/index.js",
  "bin": {
    "atomic-agent": "dist/cli/index.js",
    "atomic-agent-sidecar": "dist/sidecar/main.js"
  },
  "files": [
    "dist/**",
    "grammars/**",
    "assets/ai-models/**"
  ],
  "engines": {
    "node": ">=25.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-starter-skills.mjs",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "eval": "vitest run --config eval/vitest.config.ts",
    "eval:judge": "tsx eval/scripts/judge-from-jsonl.ts",
    "eval:lint": "tsc -p eval/tsconfig.json --noEmit",
    "eval:stub": "node eval/scripts/stub-llama-server.mjs",
    "eval:with-stub": "node eval/scripts/run-with-stub.mjs",
    "eval:full": "node eval/scripts/run-full-eval.mjs",
    "eval:gaia": "node eval/scripts/run-full-eval.mjs -t gaia-style",
    "eval:summary": "node eval/scripts/summarize-run.mjs",
    "eval:memory": "node eval-memory/scripts/run-all.mjs",
    "eval:memory:e1": "node eval-memory/scripts/run-e1.mjs",
    "eval:memory:e2": "node eval-memory/scripts/run-e2.mjs",
    "eval:memory:e3": "node eval-memory/scripts/run-e3.mjs",
    "eval:memory:e4": "node eval-memory/scripts/run-e4.mjs",
    "eval:memory:e5": "node eval-memory/scripts/run-e5.mjs",
    "eval:memory:e6": "node eval-memory/scripts/run-e6.mjs",
    "eval:memory:e7": "node eval-memory/scripts/run-e7.mjs",
    "eval:memory:e8": "node eval-memory/scripts/run-e8.mjs",
    "eval:memory:e2e": "node eval-memory/scripts/run-e2e.mjs",
    "eval:memory:v25": "node eval-memory/scripts/run-v25.mjs",
    "eval:memory:e9": "node eval-memory/scripts/run-v25.mjs -t \"E9 \"",
    "eval:memory:e10": "node eval-memory/scripts/run-v25.mjs -t \"E10 \"",
    "eval:memory:e11": "node eval-memory/scripts/run-v25.mjs -t \"E11 \"",
    "eval:memory:e12": "node eval-memory/scripts/run-v25.mjs -t \"E12 \"",
    "eval:memory:smoke:link-sweep": "node --import tsx eval-memory/scripts/smoke-link-sweep-distill.ts",
    "probe:embedding-gate": "node --import tsx eval-memory/scripts/probe-embedding-gate.mts",
    "eval:memory:lock-env": "node --import tsx eval-memory/scripts/lock-environment.ts",
    "eval:memory:datasets": "node eval-memory/scripts/download-benchmark-datasets.mjs",
    "eval:memory:locomo": "node eval-memory/scripts/run-locomo.mjs",
    "eval:memory:locomo:multi": "node eval-memory/scripts/run-locomo-multi.mjs",
    "eval:memory:longmemeval": "node eval-memory/scripts/run-longmemeval.mjs",
    "eval:memory:aggregate": "node eval-memory/scripts/aggregate-atomic-eval.mjs",
    "eval:memory:lint": "tsc -p eval-memory/tsconfig.json --noEmit",
    "eval:agents:lint": "tsc -p eval-agents/tsconfig.json --noEmit",
    "eval:agents:datasets": "node eval-agents/scripts/download-gaia.mjs",
    "eval:agents:smoke": "node eval-agents/scripts/run-smoke.mjs",
    "eval:agents:level1": "node eval-agents/scripts/run-level1.mjs",
    "eval:agents:matrix": "node eval-agents/scripts/run-matrix.mjs",
    "eval:agents:reset-hermes": "node eval-agents/scripts/reset-hermes-state.mjs",
    "eval:agents:scorecard": "node eval-agents/scripts/scorecard.mjs",
    "cli": "node --enable-source-maps dist/cli/index.js",
    "sidecar": "node --enable-source-maps dist/sidecar/main.js",
    "dev:cli": "tsx src/cli/index.ts",
    "dev:sidecar": "tsx src/sidecar/main.ts",
    "bundle:fetch-assets": "tsx scripts/fetch-assets.ts",
    "bundle:sea": "tsx scripts/bundle-sea.ts",
    "bundle:build-binary": "tsx scripts/build-binary.ts",
    "bundle:package": "tsx scripts/package-bundle.ts",
    "bundle:matrix": "tsx scripts/print-matrix.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "release": "bash scripts/release.sh",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@types/marked": "^5.0.2",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "chromium-bidi": "^15.0.0",
    "cli-highlight": "^2.1.11",
    "clipboardy": "^5.3.1",
    "cron-parser": "^5.5.0",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.7.1",
    "fuzzysort": "^3.1.0",
    "grammy": "^1.42.0",
    "html-to-text": "^10.0.0",
    "ink": "^7.0.1",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.12",
    "mammoth": "^1.12.0",
    "marked": "^18.0.2",
    "node-notifier": "^10.0.1",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.59.1",
    "react": "^19.2.5",
    "react-devtools-core": "^6.1.2",
    "tar-stream": "^3.1.8",
    "turndown": "^7.2.4",
    "word-extractor": "^1.0.4",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.12.2",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.2.14",
    "@types/tar-stream": "^3.1.4",
    "@types/turndown": "^5.0.6",
    "docx": "^9.6.1",
    "esbuild": "^0.25.0",
    "hyparquet": "^1.26.0",
    "ink-testing-library": "^4.0.0",
    "pdfkit": "^0.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "volta": {
    "node": "25.7.0"
  }
}
