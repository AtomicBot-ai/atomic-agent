+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { mkdir, mkdtemp, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { ApprovalGate } from "../../approval/approval-gate.js";
+import { resourceClassFor } from "../../agent/tool-resource-class.js";
+import { loadToolCallGrammar, parseToolCalls } from "../../llm/grammar/tool-call-grammar.js";
+import { descriptorsToOpenAiTools } from "../../llm/provider/openai/openai-tool-call-adapter.js";
+import { getToolDescriptorByName } from "../../prompt/tool-descriptors.js";
+import { FUSION_WORKER_ID_PREFIX } from "../../session/fusion-worker-session.js";
+import { confineReads } from "../read-scope/confine-reads.js";
+import { ToolRegistry, type ToolContext } from "../tool-registry.js";
+import { roleAdmits } from "../tool-roles.js";
+import { osFsExistsTool } from "./fs-exists.js";
+
+describe("os.fs.exists", () => {
+  let dir: string;
+  const ctx = (): ToolContext => ({
+    workingDir: dir,
+    sessionId: "exists-test",
+    stepIndex: 0,
+    signal: new AbortController().signal,
+  });
+  beforeEach(async () => {
+    dir = await mkdtemp(join(tmpdir(), "atomic-exists-"));
+    await writeFile(join(dir, "file.txt"), "contents must not appear in output");
+    await mkdir(join(dir, "folder"));
+  });
+  afterEach(async () => {
+    await rm(dir, { recursive: true, force: true });
+  });
+
+  it.each([
+    ["file.txt", true, "file"],
+    ["folder", true, "dir"],
+    ["missing", false, null],
+    ["missing/child", false, null],
+  ])("stats %s relative to workingDir", async (path, exists, kind) => {
+    const result = await osFsExistsTool.run({ path }, ctx());
+    expect(result.status).toBe("ok");
+    expect(result.details).toEqual({ path: join(dir, path as string), exists, kind });
+    expect(result.summary).not.toContain("contents must not appear");
+  });
+
+  it.each([undefined, null, "", 1, [], {}])("rejects a bad path: %j", async (path) => {
+    await expect(osFsExistsTool.run({ path }, ctx())).rejects.toThrow("non-empty string");
+  });
+
+  it("preserves ENOTDIR instead of reporting missing", async () => {
+    await expect(osFsExistsTool.run({ path: "file.txt/child" }, ctx()))
+      .rejects.toMatchObject({ code: "ENOTDIR" });
+  });
+
+  it.skipIf(process.platform === "win32")("identifies a device as other", async () => {
+    await symlink("/dev/null", join(dir, "device"));
+    expect((await osFsExistsTool.run({ path: "device" }, ctx())).details)
+      .toMatchObject({ exists: true, kind: "other" });
+  });
+
+  it("follows symlinks and treats a dangling target as missing", async () => {
+    await symlink(join(dir, "file.txt"), join(dir, "link"));
+    await symlink(join(dir, "absent"), join(dir, "dangling"));
+    expect((await osFsExistsTool.run({ path: "link" }, ctx())).details.kind).toBe("file");
+    expect((await osFsExistsTool.run({ path: "dangling" }, ctx())).details)
+      .toMatchObject({ exists: false, kind: null });
+  });
+
+  it("has a native schema, catalog, resource class, role and grammar entry", () => {
+    const descriptor = getToolDescriptorByName("os.fs.exists")!;
+    expect(descriptor.argsSchema).toContain("path: string");
+    const parameters = {
+      type: "object",
+      properties: { path: { type: "string", minLength: 1 } },
+      required: ["path"],
+      additionalProperties: false,
+    };
+    expect(descriptor.argsJsonSchema).toEqual(parameters);
+    expect(descriptorsToOpenAiTools([descriptor])).toContainEqual({
+      type: "function",
+      function: {
+        name: "os__fs__exists",
+        description: `${descriptor.summary}\nArgs: ${descriptor.argsSchema}`,
+        parameters,
+      },
+    });
+    expect(resourceClassFor("os.fs.exists")).toBe("pure_read");
+    expect(roleAdmits("builder", "os.fs.exists")).toBe(true);
+    expect(roleAdmits("orchestrator", "os.fs.exists")).toBe(true);
+    expect(loadToolCallGrammar()).toContain('"fs.exists"');
+    expect(parseToolCalls('[{"tool":"os.fs.exists","args":{"path":"file.txt"}}]').calls)
+      .toEqual([{ tool: "os.fs.exists", args: { path: "file.txt" } }]);
+  });
+
+  it("executes in scope and refuses outside paths through the registry wrapper", async () => {
+    const registry = new ToolRegistry();
+    registry.register(osFsExistsTool);
+    const gate = new ApprovalGate({
+      level: 3,
+      emit: (request) => queueMicrotask(() => gate.resolve({ approvalId: request.approvalId, approved: false })),
+    });
+    expect(confineReads(registry, {
+      grantedDirs: () => [],
+      readScope: () => "working-dir",
+      approvals: { approvals: gate, approvalRequired: true },
+    })).toEqual(["os.fs.exists"]);
+    expect((await registry.invoke("os.fs.exists", { path: "file.txt" }, ctx())).details.kind)
+      .toBe("file");
+    const refused = await registry.invoke("os.fs.exists", { path: "/srv/atomic-exists-outside/missing" }, ctx());
+    expect(refused.status).toBe("error");
+    expect(refused.summary).toContain("confined");
+    const workerRefused = await registry.invoke("os.fs.exists", { path: "../sibling/missing" }, {
+      ...ctx(), sessionId: `${FUSION_WORKER_ID_PREFIX}1`,
+    });
+    expect(workerRefused.status).toBe("error");
+  });
+});
