+import { stat } from "node:fs/promises";
+import { compressToolResult } from "../../compressor/result-compressor.js";
+import type { ToolDefinition } from "../tool-registry.js";
+import { resolveUserPath } from "./expand-home.js";
+
+/** Stat follows symlinks, like the other filesystem read tools. */
+export const osFsExistsTool: ToolDefinition = {
+  name: "os.fs.exists",
+  description: "Check whether a path exists and its kind without reading contents. Read-only.",
+  readonly: true,
+  async run(args, ctx) {
+    if (typeof args.path !== "string" || args.path.length === 0) {
+      throw new Error("os.fs.exists: `path` must be a non-empty string");
+    }
+    const path = resolveUserPath(args.path, ctx.workingDir);
+    let kind: "file" | "dir" | "other" | null = null;
+    try {
+      const info = await stat(path);
+      kind = info.isFile() ? "file" : info.isDirectory() ? "dir" : "other";
+    } catch (error) {
+      // Only an absent target is a successful negative answer. Permission,
+      // malformed path and other I/O failures retain their original error.
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+    }
+    const exists = kind !== null;
+    return compressToolResult({
+      tool: "os.fs.exists",
+      status: "ok",
+      output: JSON.stringify({ path, exists, kind }),
+      details: { path, exists, kind },
+    });
+  },
+};
