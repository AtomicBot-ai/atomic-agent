+import { describe, expect, it } from "vitest";
+
+import { getConfig, type AtomicAgentConfig } from "../config/index.js";
+import { ProviderRegistry } from "../llm/provider/registry/provider-registry.js";
+import { resolveVisionProvider, visionRouteAvailable } from "./vision-route.js";
+
+const logger = {
+  debug: () => {},
+  info: () => {},
+  warn: () => {},
+  error: () => {},
+} as never;
+
+function configuration(model: string, supportsVision = true): AtomicAgentConfig {
+  return {
+    ...getConfig(),
+    llm: {
+      activeTextProvider: "custom",
+      activeEmbeddingProvider: "custom",
+      toolTransport: "auto",
+      providers: [
+        {
+          id: "custom",
+          kind: "openai-compatible",
+          baseUrl: "https://custom.invalid",
+          defaultChatModel: model,
+          supportsVision,
+          userModels: [
+            { id: "text", kind: "chat", supportsVision: false },
+            { id: "vision", kind: "chat", supportsVision: true },
+            { id: "default", kind: "chat" },
+          ],
+        },
+        {
+          id: "other",
+          kind: "openai-compatible",
+          baseUrl: "https://other.invalid",
+          defaultChatModel: "text",
+          supportsVision: false,
+        },
+      ],
+    },
+  };
+}
+
+async function build(config: AtomicAgentConfig) {
+  return ProviderRegistry.fromConfig(config, {
+    config,
+    llamaClient: {} as never,
+    getProfile: () => ({}) as never,
+    logger,
+  });
+}
+
+describe("model vision overrides on the serving route", () => {
+  it.each([
+    ["text", true, false],
+    ["vision", false, true],
+    ["default", true, true],
+    ["default", false, false],
+  ] as const)("resolves %s with provider default %s to %s", async (model, providerVision, expected) => {
+    const registry = await build(configuration(model, providerVision));
+    expect(resolveVisionProvider(registry, undefined)?.capabilities.vision).toBe(expected);
+    expect(visionRouteAvailable({
+      registry,
+      isLlamaServer: () => false,
+      fusionWorkerProviderId: () => null,
+    })).toBe(expected);
+  });
+
+  it("reads the rebuilt model and switched provider on the next lookup", async () => {
+    const registry = await build(configuration("text"));
+    expect(resolveVisionProvider(registry, undefined)?.capabilities.vision).toBe(false);
+    for (const model of ["vision", "default", "text"] as const) {
+      const config = configuration(model);
+      await registry.replaceProviderFromConfig("custom", config, { config, logger });
+      expect(resolveVisionProvider(registry, undefined)?.capabilities.vision).toBe(model !== "text");
+    }
+    const config = configuration("vision");
+    await registry.replaceProviderFromConfig("custom", config, { config, logger });
+    await registry.setActive("other");
+    expect(resolveVisionProvider(registry, undefined)?.capabilities.vision).toBe(false);
+    expect(resolveVisionProvider(registry, "custom")?.capabilities.vision).toBe(true);
+    await registry.setActive("custom");
+    expect(resolveVisionProvider(registry, undefined)?.capabilities.vision).toBe(true);
+  });
+});
