+import { stat } from "node:fs/promises";
+import { compressToolResult } from "../../../compressor/result-compressor.js";
+import type { ToolDefinition } from "../../tool-registry.js";
+import { resolveUserPath } from "../expand-home.js";
+import { OS_FS_EXISTS_CONTRACT, parseExistsArgs } from "./fs-exists-contract.js";
+
+export const osFsExistsTool: ToolDefinition = {
+  name: OS_FS_EXISTS_CONTRACT.name,
+  description: OS_FS_EXISTS_CONTRACT.description,
+  readonly: OS_FS_EXISTS_CONTRACT.readonly,
+  async run(rawArgs, ctx) {
+    const args = parseExistsArgs(rawArgs);
+    const path = resolveUserPath(args.path, ctx.workingDir);
+    let kind: "file" | "dir" | "other" | null;
+    try {
+      const info = await stat(path);
+      kind = info.isFile() ? "file" : info.isDirectory() ? "dir" : "other";
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      kind = null;
+    }
+    const exists = kind !== null;
+    return compressToolResult({
+      tool: OS_FS_EXISTS_CONTRACT.name,
+      status: "ok",
+      output: `${path}: exists=${exists}, kind=${kind}`,
+      details: { path, exists, kind },
+    });
+  },
+};
