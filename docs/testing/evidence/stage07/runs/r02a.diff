+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { mkdtemp, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+import { ApprovalGate } from "../../../approval/approval-gate.js";
+import { resourceClassFor } from "../../../agent/tool-resource-class.js";
+import { USER_CONFIG_DEFAULTS } from "../../../config/config-schema.js";
+import { buildGrammarForTools, grammarToolNames } from "../../../llm/grammar/build-grammar.js";
+import { parseToolCalls } from "../../../llm/grammar/tool-call-grammar.js";
+import { descriptorsToOpenAiTools } from "../../../llm/provider/openai/openai-tool-call-adapter.js";
+import { getDefaultArgsJsonSchema } from "../../../prompt/default-tool-args-schemas.js";
+import { DEFAULT_TOOL_DESCRIPTORS } from "../../../prompt/tool-descriptors.js";
+import { FUSION_WORKER_ID_PREFIX } from "../../../session/fusion-worker-session.js";
+import { confineReads } from "../../read-scope/confine-reads.js";
+import { ToolRegistry, type ToolContext } from "../../tool-registry.js";
+import { descriptorsForRole } from "../../tool-roles.js";
+import { registerOsTools } from "../index.js";
+import { OS_FS_EXISTS_CONTRACT, parseExistsArgs } from "./fs-exists-contract.js";
+import { osFsExistsTool } from "./fs-exists.js";
+
+describe("os.fs.exists", () => {
+  let dir: string;
+  const context = (): ToolContext => ({ workingDir: dir, sessionId: "test", stepIndex: 0, signal: new AbortController().signal });
+  beforeEach(async () => { dir = await mkdtemp(join(tmpdir(), "atomic-exists-")); });
+  afterEach(async () => { await rm(dir, { recursive: true, force: true }); });
+
+  it("checks real relative files, directories and missing paths", async () => {
+    await writeFile(join(dir, "file"), "contents stay unread");
+    for (const [path, exists, kind] of [["file", true, "file"], [".", true, "dir"], ["missing", false, null]] as const) {
+      const result = await osFsExistsTool.run({ path }, context());
+      expect(result.status).toBe("ok");
+      expect(result.details).toMatchObject({ exists, kind });
+    }
+    expect((await osFsExistsTool.run({ path: "file" }, context())).details.path).toBe(join(dir, "file"));
+  });
+
+  it("follows symlinks, treating a dangling target as missing", async () => {
+    await writeFile(join(dir, "file"), "x");
+    await symlink("file", join(dir, "link"));
+    await symlink("missing", join(dir, "dangling"));
+    expect((await osFsExistsTool.run({ path: "link" }, context())).details.kind).toBe("file");
+    expect((await osFsExistsTool.run({ path: "dangling" }, context())).details).toMatchObject({ exists: false, kind: null });
+  });
+
+  it.skipIf(process.platform === "win32")("reports other for a real FIFO", async () => {
+    const path = join(dir, "fifo");
+    await promisify(execFile)("mkfifo", [path]);
+    expect((await osFsExistsTool.run({ path }, context())).details).toMatchObject({ exists: true, kind: "other" });
+  });
+
+  it.each([undefined, null, "", 1, false, [], {}])("rejects invalid path %j", async (path) => {
+    expect(() => parseExistsArgs({ path })).toThrow(/non-empty string/);
+    await expect(osFsExistsTool.run({ path }, context())).rejects.toThrow(/non-empty string/);
+  });
+
+  it("preserves errors other than ENOENT", async () => {
+    await writeFile(join(dir, "file"), "x");
+    await expect(osFsExistsTool.run({ path: "file/child" }, context())).rejects.toMatchObject({ code: "ENOTDIR" });
+  });
+
+  it("connects registration, catalog, native schema, class and grammar for each role", async () => {
+    const registry = new ToolRegistry();
+    registerOsTools(registry, { approvals: new ApprovalGate({ emit: () => { throw new Error("unexpected approval"); } }), approvalRequired: false, config: USER_CONFIG_DEFAULTS, listRecentSessionDirs: () => [] });
+    expect(registry.get("os.fs.exists")).toBe(osFsExistsTool);
+    expect(osFsExistsTool.readonly).toBe(true);
+    expect(resourceClassFor("os.fs.exists")).toBe("pure_read");
+    expect(getDefaultArgsJsonSchema("os.fs.exists")).toEqual(OS_FS_EXISTS_CONTRACT.argsJsonSchema);
+    const descriptor = DEFAULT_TOOL_DESCRIPTORS.filter((d) => d.name === "os.fs.exists");
+    expect(descriptor).toHaveLength(1);
+    expect(descriptor[0]).toEqual({ ...OS_FS_EXISTS_CONTRACT.descriptor, argsJsonSchema: OS_FS_EXISTS_CONTRACT.argsJsonSchema });
+    const native = descriptorsToOpenAiTools(descriptor).find((tool) => (tool.function as { name: string }).name === "os__fs__exists");
+    expect(native?.function).toMatchObject({ parameters: { properties: { path: { type: "string", minLength: 1 } }, required: ["path"], additionalProperties: false } });
+    const base = await readFile(join(process.cwd(), "grammars/tool-call.gbnf"), "utf8");
+    expect(base.match(/^os-tool ::= .*$/m)?.[0]).toContain('"fs.exists"');
+    for (const role of ["builder", "orchestrator", "full"] as const) {
+      const offered = descriptorsForRole(role, DEFAULT_TOOL_DESCRIPTORS, new Set());
+      expect(grammarToolNames(buildGrammarForTools(base, offered.map((d) => d.name)))).toContain("os.fs.exists");
+    }
+    expect(parseToolCalls('[{"tool":"os.fs.exists","args":{"path":"file"}}]').calls[0]).toMatchObject({ tool: "os.fs.exists", args: { path: "file" } });
+  });
+
+  it("runs through the read-scope wrapper and refuses an outside worker path", async () => {
+    await writeFile(join(dir, "file"), "x");
+    const registry = new ToolRegistry();
+    registry.register(osFsExistsTool);
+    expect(confineReads(registry, { grantedDirs: () => [] })).toEqual(["os.fs.exists"]);
+    const ctx = { ...context(), sessionId: `${FUSION_WORKER_ID_PREFIX}exists` };
+    expect((await registry.invoke("os.fs.exists", { path: "file" }, ctx)).details).toMatchObject({ exists: true, kind: "file" });
+    expect((await registry.invoke("os.fs.exists", { path: "../outside-missing" }, ctx)).status).toBe("error");
+  });
+});
