+  it("preserves the loaded panel across refresh failure and retry", () => {
+    let s = createInitialTuiState();
+    s = dispatch(s, {
+      type: "mcp_rows_loaded",
+      rows: [row("a"), row("docs")],
+      emptyHint: null,
+      at: 1000,
+    });
+    s = dispatch(s, { type: "mcp_cursor_set", row: 1 });
+    s = dispatch(s, {
+      type: "mcp_detail_opened",
+      rowKey: "docs",
+      detail: detail("docs"),
+    });
+    s = dispatch(s, { type: "mcp_detail_tab_set", tab: "resources" });
+    const loadedPanel = s.mcpPanel;
+
+    const started = dispatch(s, { type: "mcp_refresh_started" });
+    expect(started.mcpPanel).toEqual({ ...loadedPanel, loading: true });
+
+    const failed = dispatch(started, {
+      type: "mcp_refresh_failed",
+      error: "snapshot unavailable",
+    });
+    expect(failed.mcpPanel).toEqual({
+      ...loadedPanel,
+      loading: false,
+      lastError: "snapshot unavailable",
+    });
+    expect(failed.mcpPanel.rows).toBe(loadedPanel.rows);
+    expect(failed.mcpPanel.detail).toBe(loadedPanel.detail);
+    expect(started.mcpPanel.loading).toBe(true);
+    expect(started.mcpPanel.lastError).toBeNull();
+
+    const retried = dispatch(failed, { type: "mcp_refresh_started" });
+    expect(retried.mcpPanel).toEqual({ ...loadedPanel, loading: true });
+    expect(retried.mcpPanel.rows).toBe(loadedPanel.rows);
+    expect(retried.mcpPanel.detail).toBe(loadedPanel.detail);
+
+    const recovered = dispatch(retried, {
+      type: "mcp_rows_loaded",
+      rows: [row("docs")],
+      emptyHint: null,
+      at: 2000,
+    });
+    expect(recovered.mcpPanel.loading).toBe(false);
+    expect(recovered.mcpPanel.lastError).toBeNull();
+    expect(recovered.mcpPanel.cursor).toBe(0);
+    expect(recovered.mcpPanel.lastRefreshedAt).toBe(2000);
+  });
