{
  "name": "@atomicagent/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Atomic Agent NDJSON sidecar: start threads, run turns, stream typed events.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "cd ../.. && npx vitest run sdk/typescript"
  }
}
